      {"contract": "persistent-object", "version": "1", "kind": "storage-contract", "stability": "experimental", "fingerprint_sources": ["src/store/application.mncs", "src/store/content.mncs", "src/store/generation.mncs", "python/mncs_store/"]},
      {"contract": "scalable-content", "version": "1", "kind": "storage-contract", "stability": "experimental", "fingerprint_sources": ["src/store/content.mncs", "python/mncs_store/embedded.py", "docs/invariants.md"]},
      {"contract": "durable-publication", "version": "1", "kind": "storage-contract", "stability": "experimental", "fingerprint_sources": ["src/store/generation.mncs", "src/store/publication.mncs", "src/store/recovery.mncs", "python/mncs_store/embedded.py"]},
      {"contract": "typed-relations", "version": "2", "kind": "storage-contract", "stability": "experimental", "fingerprint_sources": ["src/store/relationship.mncs", "src/store/provenance.mncs"]},
      {"contract": "provenance", "version": "1", "kind": "storage-contract", "stability": "experimental", "fingerprint_sources": ["src/store/provenance.mncs", "docs/invariants.md"]},
      {"contract": "commit-feed", "version": "1", "kind": "storage-contract", "stability": "experimental", "fingerprint_sources": ["src/store/commit_feed.mncs"]},
      {"contract": "semantic-state", "version": "1", "kind": "storage-contract", "stability": "experimental", "fingerprint_sources": ["src/store/semantic_state.mncs"]},
      {"contract": "adaptive-representations", "version": "1", "kind": "storage-contract", "stability": "experimental", "fingerprint_sources": ["src/store/envelope.mncs", "src/store/representation.mncs", "src/store/intent.mncs", "src/store/block.mncs", "src/store/plan.mncs", "src/store/codec.mncs", "src/store/canonical.mncs", "python/mncs_store/embedded.py"]}
    ],
    "consumes": [{"contract": "mncs-language.source-profile", "envelope": {"op": "compatible-minor", "version": "0.16", "minimum_required": "0.16", "compatibility_ceiling": "0.18"}, "required": true, "evidence_refs": ["src/store/publication.mncs", "tests/mncs_exec.py"]}, {"contract": "mncs.ingest.typed-handoff", "envelope": {"op": "exact", "version": "1"}, "required": false, "scope": "import/migration only; native producers persist directly through persistent-object", "evidence_refs": ["docs/consumer-contracts.md", "docs/pressure-reconciliation.md"]}],
    "tests": [{"test": "store-native-substrate", "covers": ["persistent-object", "scalable-content", "durable-publication", "typed-relations", "commit-feed", "semantic-state"], "obligation": "self", "command": {"argv": ["python3", "-m", "pytest", "tests/test_native_substrate.py", "-q"]}}, {"test": "store-adaptive-representations", "covers": ["adaptive-representations", "persistent-object", "scalable-content"], "obligation": "self", "command": {"argv": ["python3", "-m", "pytest", "tests/test_adaptive_store.py", "-q"], "environment": {"PYTHONPATH": "python", "MNCS_STORE_PYTHON": "python"}}}, {"test": "store-tests", "covers": ["persistent-object", "scalable-content", "durable-publication"], "obligation": "scheduled", "command": {"argv": ["python3", "-m", "pytest", "tests", "-q"], "environment": {"PYTHONPATH": "python", "MNCS_STORE_PYTHON": "python"}}}, {"test": "store-domain-prefix-query", "covers": ["persistent-object"], "obligation": "self", "command": {"argv": ["python3", "-m", "pytest", "tests/test_embedded_store.py", "-k", "domain_prefix_query", "-q"], "environment": {"PYTHONPATH": "python", "MNCS_STORE_PYTHON": "python"}}}, {"test": "store-historical-object-projection", "covers": ["persistent-object"], "obligation": "self", "command": {"argv": ["python3", "-m", "pytest", "tests/test_embedded_store.py", "-k", "objects_at_returns_verified_historical_generation", "-q"], "environment": {"PYTHONPATH": "python", "MNCS_STORE_PYTHON": "python"}}}]
  }
