mncs 0.13;

// store.identity — Phase 1 persistent identity primitives (RFC 0002).
//
// Two identity domains stay structurally distinct:
//
// - Logical object identity: 12-byte canonical encoding,
//   `[namespace BE u32][serial BE u64]`. Stable across value evolution,
//   placement changes, and replicas. Serials are issued by the store's
//   host-side counter (see pressure P1-013); this module owns the byte
//   encoding, parsing, and equality, never issuance.
// - Content identity: 32-byte SHA-256 digests over canonical framed bytes.
//   Digest PRODUCTION stays behind the `sha256_digest` capability boundary
//   (store.chunk); this module owns comparison, ordering, zero detection,
//   and matching a stored digest against freshly computed digest bytes.
//
// Width separation is load-bearing: `[byte; 12]` and `[byte; 32]` are
// different types, so passing an object encoding where a digest is expected
// (or vice versa) fails elaboration. The record wrappers below add nominal
// separation between the three 32-byte roles (content / chunk / root),
// which share a width but must never interchange silently.
//
// Endianness: big-endian throughout, matching `mncs.std.encoding.v1`.
// The store deliberately depends on no stdlib module: canonical store bytes
// must be frozen against stdlib evolution (see RFC 0016).
module store.identity.v1;

// Nominal domain wrappers. No cross-type equality function exists on
// purpose: there is no well-typed way to compare a ChunkId with a RootId.
record LogicalId { namespace: u32, serial: u64 }

record ContentId { digest: [byte; 32] }

record ChunkId { digest: [byte; 32] }

record RootId { digest: [byte; 32] }

// Canonical 12-byte logical encoding: namespace (u32 BE) then serial.
fn object_encode(namespace: u32, serial: u64) -> (result: [byte; 12]) {
    let n0: byte = (namespace / 16777216) as byte;
    let nr0: u32 = namespace % 16777216;
    let n1: byte = (nr0 / 65536) as byte;
    let nr1: u32 = nr0 % 65536;
    let n2: byte = (nr1 / 256) as byte;
    let n3: byte = (nr1 % 256) as byte;
    let s0: byte = (serial / 72057594037927936) as byte;
    let sr0: u64 = serial % 72057594037927936;
    let s1: byte = (sr0 / 281474976710656) as byte;
    let sr1: u64 = sr0 % 281474976710656;
    let s2: byte = (sr1 / 1099511627776) as byte;
    let sr2: u64 = sr1 % 1099511627776;
    let s3: byte = (sr2 / 4294967296) as byte;
    let sr3: u64 = sr2 % 4294967296;
    let s4: byte = (sr3 / 16777216) as byte;
    let sr4: u64 = sr3 % 16777216;
    let s5: byte = (sr4 / 65536) as byte;
    let sr5: u64 = sr4 % 65536;
    let s6: byte = (sr5 / 256) as byte;
    let s7: byte = (sr5 % 256) as byte;
    return [n0, n1, n2, n3, s0, s1, s2, s3, s4, s5, s6, s7];
}

// Total decoders. Total by type: twelve bytes always form a valid pair,
// so there is no failure mode. Validity of the IDENTITY (known namespace,
// issued serial) is a store-level question, not an encoding question.
fn object_namespace(id: [byte; 12]) -> (result: u32) {
    // Wrapping operators are exact here, not approximate: every product and
    // the sum fit u32 by construction (max 0xFFFFFFFF), so mod-2^32 folds
    // equal the true value. Plain `*`/`+` trap on some backends for
    // large-but-valid products (see pressure P1-B01); wrapping keeps the
    // decoder total and backend-uniform.
    let high: u32 = ((id[0] as u32) *% 16777216)
        +% ((id[1] as u32) *% 65536)
        +% ((id[2] as u32) *% 256);
    return high +% (id[3] as u32);
}

fn object_serial(id: [byte; 12]) -> (result: u64) {
    let s0: u64 = (id[4] as u64) *% 72057594037927936;
    let s1: u64 = s0 +% ((id[5] as u64) *% 281474976710656);
    let s2: u64 = s1 +% ((id[6] as u64) *% 1099511627776);
    let s3: u64 = s2 +% ((id[7] as u64) *% 4294967296);
    let s4: u64 = s3 +% ((id[8] as u64) *% 16777216);
    let s5: u64 = s4 +% ((id[9] as u64) *% 65536);
    let s6: u64 = s5 +% ((id[10] as u64) *% 256);
    return s6 +% (id[11] as u64);
}

// Encode/decode round-trip law over one identity.
fn object_roundtrip(namespace: u32, serial: u64) -> (result: bool) {
    let encoded: [byte; 12] = object_encode(namespace, serial);
    return object_namespace(encoded) == namespace && object_serial(encoded) == serial;
}

fn object_equal(left: [byte; 12], right: [byte; 12]) -> (result: bool) {
    iterate i over left carrying same: bool = true {
        next same = same && left[i] == right[i];
    }
    return same;
}

fn object_is_zero(id: [byte; 12]) -> (result: bool) {
    iterate i over id carrying zero: bool = true {
        next zero = zero && id[i] == 0;
    }
    return zero;
}

// Same content may back many logical objects without merging them: content
// equality is a separate function over a separate width, and there is no
// function comparing a 12-byte encoding with a 32-byte digest.
fn content_equal(left: [byte; 32], right: [byte; 32]) -> (result: bool) {
    iterate i over left carrying same: bool = true {
        next same = same && left[i] == right[i];
    }
    return same;
}

fn content_is_zero(value: [byte; 32]) -> (result: bool) {
    iterate i over value carrying zero: bool = true {
        next zero = zero && value[i] == 0;
    }
    return zero;
}

record OrderState { decided: bool, before: bool }

// Canonical byte ordering for digest keys: the first differing byte
// decides, so a later byte cannot reverse the verdict.
//
// Modernized for Source Profile 0.13: `==` over `bool` (P1-009, resolved)
// and `<` over `byte` (P1-010, resolved) let the ordering read as boolean
// logic instead of the Phase-1a i64 0/1 flag discipline. Illegal states
// (a flag holding 2) are unrepresentable in this spelling.
fn content_less(left: [byte; 32], right: [byte; 32]) -> (result: bool) {
    let initial: OrderState = OrderState { decided: false, before: false };
    iterate i over left carrying state: OrderState = initial {
        let different: bool = left[i] != right[i];
        let first: bool = !state.decided && different;
        let below: bool = left[i] < right[i];
        next state = OrderState {
            decided: state.decided || different,
            before: state.before || (first && below)
        };
    }
    return state.decided && state.before;
}

// Match a stored 32-byte digest against freshly computed digest bytes
// (for example `sha256_digest` output, whose runtime length must be 32).
// Length mismatch is false, never a trap: untrusted digests are data.
fn digest_matches(stored: [byte; 32], fresh: [byte; up_to 64]) -> (result: bool) {
    if fresh.len != 32 {
        return false;
    }
    iterate i over stored carrying same: bool = true {
        next same = same && stored[i] == fresh[i];
    }
    return same;
}

// Nominal constructors and projectors. Each role converts through its own
// functions; constructing a ChunkId from a RootId's bytes requires an
// explicit projection followed by an explicit construction, so the crossing
// is always visible at the call site.
fn logical_make(namespace: u32, serial: u64) -> (result: LogicalId) {
    return LogicalId { namespace: namespace, serial: serial };
}

fn logical_namespace(id: LogicalId) -> (result: u32) {
    return id.namespace;
}

fn logical_serial(id: LogicalId) -> (result: u64) {
    return id.serial;
}

fn content_make(digest: [byte; 32]) -> (result: ContentId) {
    return ContentId { digest: digest };
}

fn content_bytes(id: ContentId) -> (result: [byte; 32]) {
    return id.digest;
}

fn chunk_make(digest: [byte; 32]) -> (result: ChunkId) {
    return ChunkId { digest: digest };
}

fn chunk_bytes(id: ChunkId) -> (result: [byte; 32]) {
    return id.digest;
}

fn root_make(digest: [byte; 32]) -> (result: RootId) {
    return RootId { digest: digest };
}

fn root_bytes(id: RootId) -> (result: [byte; 32]) {
    return id.digest;
}

// Scalar-boundary round trips through the nominal wrappers. Corpora can
// only exchange scalars and byte sequences with the host, so these laws
// prove the record layer carries values faithfully without exposing
// nominal identities across the process boundary (see pressure P1-010).
fn logical_roundtrip(namespace: u32, serial: u64) -> (result: bool) {
    let id: LogicalId = logical_make(namespace, serial);
    return logical_namespace(id) == namespace && logical_serial(id) == serial;
}

fn content_roundtrip(digest: [byte; 32]) -> (result: bool) {
    let id: ContentId = content_make(digest);
    return content_equal(content_bytes(id), digest);
}

fn chunk_roundtrip(digest: [byte; 32]) -> (result: bool) {
    let id: ChunkId = chunk_make(digest);
    return content_equal(chunk_bytes(id), digest);
}

fn root_roundtrip(digest: [byte; 32]) -> (result: bool) {
    let id: RootId = root_make(digest);
    return content_equal(root_bytes(id), digest);
}
