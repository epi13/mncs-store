mncs 0.13;

// store.generation — Phase 2 generation, snapshot, and commit semantics
// (RFC 0005, RFC 0017).
//
// This module owns the VALUE semantics of generations: header encoding,
// compare-and-transition decisions, snapshot binding, commit state
// transitions, and reclamation membership. The host lifecycle layer
// transports files and performs the filesystem mutations the language
// cannot yet express (P1-001..P1-003, P2-004..P2-006); every DECISION —
// which generation wins, which chunk is unreachable, which transition is
// legal — is computed here.
//
// Generation files keep the Phase-1a layout (RFC 0016, unchanged):
// 8-byte header `MG|1|0|0|count u32` followed by N 44-byte records
// `[object 12][root 32]` (see store.manifest.gen_record*).
module store.generation.v1;

use store.identity;

// Generation header: 8 bytes `MG|ver=1|res=0|count u32 BE`.
fn header(count: u32) -> (result: [byte; 8]) {
    let c0: byte = (count / 16777216) as byte;
    let cr0: u32 = count % 16777216;
    let c1: byte = (cr0 / 65536) as byte;
    let cr1: u32 = cr0 % 65536;
    let c2: byte = (cr1 / 256) as byte;
    let c3: byte = (cr1 % 256) as byte;
    return [77, 71, 1, 0, c0, c1, c2, c3];
}

// Total validation of a generation-file view. Codes: 0 OK,
// 1 BAD_VIEW_LEN (fewer than 8 bytes or a non-record-multiple tail),
// 2 BAD_MAGIC, 3 BAD_VERSION, 4 BAD_RESERVED,
// 5 COUNT_MISMATCH (declared count disagrees with the record multiple).
fn header_validate(view: [byte; up_to 1024]) -> (result: u64) {
    if view.len < 8 {
        return 1;
    }
    if view[0] != 77 || view[1] != 71 {
        return 2;
    }
    if view[2] != 1 {
        return 3;
    }
    if view[3] != 0 {
        return 4;
    }
    let count: u64 = ((view[4] as u64) *% 16777216)
        +% ((view[5] as u64) *% 65536)
        +% ((view[6] as u64) *% 256)
        +% (view[7] as u64);
    let body: u64 = view.len -% 8;
    if body % 44 != 0 {
        return 1;
    }
    if body / 44 != count {
        return 5;
    }
    return 0;
}

// Declared record count of a validated generation view. The caller must
// establish `header_validate(view) == 0` first.
fn header_count(view: [byte; up_to 1024]) -> (result: u32) {
    let high: u32 = ((view[4] as u32) *% 16777216)
        +% ((view[5] as u32) *% 65536)
        +% ((view[6] as u32) *% 256);
    return high +% (view[7] as u32);
}

// Note: no in-language header round-trip law: `header_validate` takes the
// widest view (generation files hold up to 1024 bytes) and narrower views
// do not subsume into it (P1-012), so an 8-byte header cannot be fed back
// in-language. The corpus pins the round trip across the harness boundary
// instead: `header(count)` bytes are passed back as arguments and must
// validate with `header_count` echoing the count.

// Compare-and-transition decision (compare-and-swap semantics):
// given the observed current generation C and the writer's expected
// generation E, the proposed generation commits if and only if C == E.
// Returns 0 COMMIT when the transition may proceed, 1 CONFLICT when the
// writer is stale. The outcome is total and deterministic; the store
// MUST NOT silently retry a conflict away (RFC 0005).
fn cas_decide(current: u64, expected: u64) -> (result: u64) {
    if current == expected {
        return 0;
    }
    return 1;
}

// Conflict token: the typed stale-writer outcome. A conflict carries the
// observed current generation and the attempted (expected) generation so
// the writer can reason about what it saw:
//
//   offset  size  field
//   0       2     magic "CF" (0x43 0x46)
//   2       1     version (1)
//   3       1     reserved (0)
//   4       4     observed current generation u32 BE
//   8       4     attempted generation u32 BE
//   12      4     reserved (0,0,0,0)
fn conflict_token(observed: u32, attempted: u32) -> (result: [byte; 16]) {
    let o0: byte = (observed / 16777216) as byte;
    let or0: u32 = observed % 16777216;
    let o1: byte = (or0 / 65536) as byte;
    let or1: u32 = or0 % 65536;
    let o2: byte = (or1 / 256) as byte;
    let o3: byte = (or1 % 256) as byte;
    let a0: byte = (attempted / 16777216) as byte;
    let ar0: u32 = attempted % 16777216;
    let a1: byte = (ar0 / 65536) as byte;
    let ar1: u32 = ar0 % 65536;
    let a2: byte = (ar1 / 256) as byte;
    let a3: byte = (ar1 % 256) as byte;
    return [67, 70, 1, 0, o0, o1, o2, o3, a0, a1, a2, a3, 0, 0, 0, 0];
}

// Total validation of a conflict token view. Codes: 0 OK, 1 BAD_VIEW_LEN,
// 2 BAD_MAGIC, 3 BAD_VERSION, 4 BAD_RESERVED.
fn conflict_validate(view: [byte; up_to 16]) -> (result: u64) {
    if view.len != 16 {
        return 1;
    }
    if view[0] != 67 || view[1] != 70 {
        return 2;
    }
    if view[2] != 1 {
        return 3;
    }
    if view[3] != 0 {
        return 4;
    }
    if view[12] != 0 || view[13] != 0 || view[14] != 0 || view[15] != 0 {
        return 4;
    }
    return 0;
}

fn conflict_observed(token: [byte; 16]) -> (result: u32) {
    let high: u32 = ((token[4] as u32) *% 16777216)
        +% ((token[5] as u32) *% 65536)
        +% ((token[6] as u32) *% 256);
    return high +% (token[7] as u32);
}

fn conflict_attempted(token: [byte; 16]) -> (result: u32) {
    let high: u32 = ((token[8] as u32) *% 16777216)
        +% ((token[9] as u32) *% 65536)
        +% ((token[10] as u32) *% 256);
    return high +% (token[11] as u32);
}

// Snapshot token: binds a reader to one committed generation. Reads
// served under a token MUST resolve every object through that
// generation's mapping (invariant 9); concurrent publication of a newer
// generation MUST NOT change what the token observes.
//
//   offset  size  field
//   0       2     magic "SN" (0x53 0x4E)
//   2       1     version (1)
//   3       1     flags (0)
//   4       4     bound generation u32 BE
//   8       4     reserved (0,0,0,0)
fn snap_make(gen: u32) -> (result: [byte; 12]) {
    let g0: byte = (gen / 16777216) as byte;
    let gr0: u32 = gen % 16777216;
    let g1: byte = (gr0 / 65536) as byte;
    let gr1: u32 = gr0 % 65536;
    let g2: byte = (gr1 / 256) as byte;
    let g3: byte = (gr1 % 256) as byte;
    return [83, 78, 1, 0, g0, g1, g2, g3, 0, 0, 0, 0];
}

// Total validation of a snapshot token view. Codes: 0 OK, 1 BAD_VIEW_LEN,
// 2 BAD_MAGIC, 3 BAD_VERSION, 4 BAD_FLAGS.
fn snap_validate(view: [byte; up_to 12]) -> (result: u64) {
    if view.len != 12 {
        return 1;
    }
    if view[0] != 83 || view[1] != 78 {
        return 2;
    }
    if view[2] != 1 {
        return 3;
    }
    if view[3] != 0 {
        return 4;
    }
    if view[8] != 0 || view[9] != 0 || view[10] != 0 || view[11] != 0 {
        return 4;
    }
    return 0;
}

fn snap_gen(token: [byte; 12]) -> (result: u32) {
    let high: u32 = ((token[4] as u32) *% 16777216)
        +% ((token[5] as u32) *% 65536)
        +% ((token[6] as u32) *% 256);
    return high +% (token[7] as u32);
}

// Snapshot binding decision: a read naming generation G is servable under
// token T if and only if T validates and G equals the bound generation.
// Generation stability is this equality: the read path resolves through
// exactly one generation file, so a concurrent publish can neither mix
// generations into an in-flight read nor move a bound reader forward.
fn snap_permits(token_view: [byte; up_to 12], gen: u64) -> (result: bool) {
    if snap_validate(token_view) != 0 {
        return false;
    }
    let bound: u64 = (((token_view[4] as u64) *% 16777216)
        +% ((token_view[5] as u64) *% 65536)
        +% ((token_view[6] as u64) *% 256))
        +% (token_view[7] as u64);
    return bound == gen;
}

// Commit state machine (RFC 0005 publication, RFC 0017 states).
// States: 0 PREPARING, 1 CONTENT_READY, 2 CANDIDATE, 3 DURABLE_PREREQ,
// 4 PUBLISHED (terminal), 5 ABORTED (terminal, recoverable).
// `commit_next` is the single transition authority: legal advances move
// forward exactly one state on step success; any step failure aborts;
// terminal states never move. The host driver reports step outcomes; the
// TABLE (which transition is legal) lives here, so an out-of-order or
// repeated commit step is a deterministic abort, never a silent skip.
fn commit_next(state: u64, step_ok: bool) -> (result: u64) {
    if state == 4 || state == 5 {
        return state;
    }
    if state > 5 {
        return 5;
    }
    if !step_ok {
        return 5;
    }
    if state == 0 || state == 1 || state == 2 || state == 3 {
        return state +% 1;
    }
    return 5;
}

fn commit_terminal(state: u64) -> (result: bool) {
    return state == 4 || state == 5;
}

// Reclamation membership over a retained-roots table.
//
// The host assembles TABLE as entries 32-byte root digests zero-padded to
// exactly 1024 bytes (at most 32 entries; padding is transport, never
// semantics). This predicate decides whether TARGET is retained: it scans
// the full table with a 32-byte sliding window and latches on an aligned,
// in-range, byte-exact entry. Padding bytes can never produce a hit: a
// hit requires the window to sit entirely below entries*32 at a 32-byte
// boundary. Returns false for entries > 32 (bound refusal, never a trap).
//
// A shared chunk MUST NOT be deleted merely because one generation
// stopped referencing it (RFC 0004): the caller must union the chunk
// digests named by freshly verified retained manifests (live
// generations, live snapshot pins, retention policy) before asking —
// never bare roots, which name manifests, not chunks. The union is
// transport; the membership verdict is semantics.
//
// Measured cost (research-bytecode, 2026-09-10): a full 1024-byte scan
// takes ~34k steps, just above the harness's 32k default budget —
// callers pass an explicit budget for reclamation scans. The per-step
// helper call dominates; see pressure P2-008.
// The scan carries an incremental mismatch latch instead of comparing a
// buffered window per step: a per-step 32-byte callee call costs more
// than 250 steps per table byte (measured; see pressure P2-008), which
// exhausts ordinary step budgets over a 1024-byte table. Latching one
// byte per step keeps the scan linear with a small constant.
record ScanState { bad: bool, found: bool }

fn scan_step(
    state: ScanState,
    elem: byte,
    index: u64,
    limit: u64,
    target: [byte; 32]
) -> (result: ScanState) {
    // The entry slot is always index % 32: both start at 0 and advance by
    // one per table byte, so no slot counter needs carrying.
    let want: byte = target[index % 32];
    let mismatch: bool = index < limit && elem != want;
    let now_bad: bool = state.bad || mismatch;
    let boundary: bool = (index +% 1) % 32 == 0;
    let hit: bool = index < limit && boundary && !now_bad;
    return ScanState {
        bad: now_bad && !boundary,
        found: state.found || hit
    };
}

fn table_contains(
    table: [byte; 1024],
    entries: u64,
    target: [byte; 32]
) -> (result: bool) {
    if entries > 32 {
        return false;
    }
    let limit: u64 = entries *% 32;
    let initial: ScanState = ScanState { bad: false, found: false };
    iterate i over table carrying state: ScanState = initial {
        next state = scan_step(state, table[i], i, limit, target);
    }
    return state.found;
}
