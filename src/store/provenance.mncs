mncs 0.13;

// store.provenance.v1 — a typed provenance record independent of payload.
//
//   0..1   magic MP
//   2      representation version
//   3      flags (reserved)
//   4..15  source identity
//   16..27 producer identity
//   28..39 transformation identity
//   40..47 Store generation
//   48..79 evidence digest
//   80..111 ancestry digest
module store.provenance.v1;

record Provenance {
    source: [byte; 12],
    producer: [byte; 12],
    transformation: [byte; 12],
    generation: u64,
    evidence: [byte; 32],
    ancestry: [byte; 32]
}

fn u64_bytes(value: u64) -> (result: [byte; 8]) {
    let b0: byte = (value / 72057594037927936) as byte;
    let r0: u64 = value % 72057594037927936;
    let b1: byte = (r0 / 281474976710656) as byte;
    let r1: u64 = r0 % 281474976710656;
    let b2: byte = (r1 / 1099511627776) as byte;
    let r2: u64 = r1 % 1099511627776;
    let b3: byte = (r2 / 4294967296) as byte;
    let r3: u64 = r2 % 4294967296;
    let b4: byte = (r3 / 16777216) as byte;
    let r4: u64 = r3 % 16777216;
    let b5: byte = (r4 / 65536) as byte;
    let r5: u64 = r4 % 65536;
    let b6: byte = (r5 / 256) as byte;
    let b7: byte = (r5 % 256) as byte;
    return [b0, b1, b2, b3, b4, b5, b6, b7];
}

fn copy12(out: [byte; 112], offset: u64, value: [byte; 12]) -> (result: [byte; 112]) {
    iterate i over value carrying row: [byte; 112] = out {
        next row = replace(row, offset +% i, value[i]);
    }
    return row;
}

fn copy32(out: [byte; 112], offset: u64, value: [byte; 32]) -> (result: [byte; 112]) {
    iterate i over value carrying row: [byte; 112] = out {
        next row = replace(row, offset +% i, value[i]);
    }
    return row;
}

fn copy8(out: [byte; 112], offset: u64, value: [byte; 8]) -> (result: [byte; 112]) {
    iterate i over value carrying row: [byte; 112] = out {
        next row = replace(row, offset +% i, value[i]);
    }
    return row;
}

fn encode(value: Provenance) -> (result: [byte; 112]) {
    let seed: [byte; 112] = [0; 112];
    let tagged: [byte; 112] = replace(replace(replace(replace(seed,
        0, 77), 1, 80), 2, 1), 3, 0);
    let s: [byte; 112] = copy12(tagged, 4, value.source);
    let p: [byte; 112] = copy12(s, 16, value.producer);
    let t: [byte; 112] = copy12(p, 28, value.transformation);
    let g: [byte; 112] = copy8(t, 40, u64_bytes(value.generation));
    let e: [byte; 112] = copy32(g, 48, value.evidence);
    return copy32(e, 80, value.ancestry);
}

// Codes: 0 valid, 1 wrong length, 2 magic, 3 version, 4 flags/reserved.
fn validate(view: [byte; up_to 112]) -> (result: u64) {
    if view.len != 112 { return 1; }
    if view[0] != 77 || view[1] != 80 { return 2; }
    if view[2] != 1 { return 3; }
    if view[3] != 0 { return 4; }
    return 0;
}

fn source(view: [byte; 112]) -> (result: [byte; 12]) {
    let out: [byte; 12] = [0; 12];
    iterate i over out carrying row: [byte; 12] = out {
        next row = replace(row, i, view[4 +% i]);
    }
    return row;
}

fn producer(view: [byte; 112]) -> (result: [byte; 12]) {
    let out: [byte; 12] = [0; 12];
    iterate i over out carrying row: [byte; 12] = out {
        next row = replace(row, i, view[16 +% i]);
    }
    return row;
}

fn transformation(view: [byte; 112]) -> (result: [byte; 12]) {
    let out: [byte; 12] = [0; 12];
    iterate i over out carrying row: [byte; 12] = out {
        next row = replace(row, i, view[28 +% i]);
    }
    return row;
}

fn generation(view: [byte; 112]) -> (result: u64) {
    let b0: u64 = (view[40] as u64) *% 72057594037927936;
    let b1: u64 = b0 +% ((view[41] as u64) *% 281474976710656);
    let b2: u64 = b1 +% ((view[42] as u64) *% 1099511627776);
    let b3: u64 = b2 +% ((view[43] as u64) *% 4294967296);
    let b4: u64 = b3 +% ((view[44] as u64) *% 16777216);
    let b5: u64 = b4 +% ((view[45] as u64) *% 65536);
    let b6: u64 = b5 +% ((view[46] as u64) *% 256);
    return b6 +% (view[47] as u64);
}

fn evidence(view: [byte; 112]) -> (result: [byte; 32]) {
    let out: [byte; 32] = [0; 32];
    iterate i over out carrying row: [byte; 32] = out {
        next row = replace(row, i, view[48 +% i]);
    }
    return row;
}

fn ancestry(view: [byte; 112]) -> (result: [byte; 32]) {
    let out: [byte; 32] = [0; 32];
    iterate i over out carrying row: [byte; 32] = out {
        next row = replace(row, i, view[80 +% i]);
    }
    return row;
}

fn equal12(left: [byte; 12], right: [byte; 12]) -> (result: bool) {
    iterate i over left carrying same: bool = true {
        next same = same && left[i] == right[i];
    }
    return same;
}

fn equal32(left: [byte; 32], right: [byte; 32]) -> (result: bool) {
    iterate i over left carrying same: bool = true {
        next same = same && left[i] == right[i];
    }
    return same;
}

fn roundtrip(value: Provenance) -> (result: bool) {
    let bytes: [byte; 112] = encode(value);
    return validate(bytes) == 0
        && equal12(source(bytes), value.source)
        && equal12(producer(bytes), value.producer)
        && equal12(transformation(bytes), value.transformation)
        && generation(bytes) == value.generation
        && equal32(evidence(bytes), value.evidence)
        && equal32(ancestry(bytes), value.ancestry);
}

fn encode_fields(source_value: [byte; 12], producer_value: [byte; 12], transformation_value: [byte; 12], generation_value: u64, evidence_value: [byte; 32], ancestry_value: [byte; 32]) -> (result: [byte; 112]) {
    return encode(Provenance {
        source: source_value,
        producer: producer_value,
        transformation: transformation_value,
        generation: generation_value,
        evidence: evidence_value,
        ancestry: ancestry_value
    });
}

fn roundtrip_fields(source_value: [byte; 12], producer_value: [byte; 12], transformation_value: [byte; 12], generation_value: u64, evidence_value: [byte; 32], ancestry_value: [byte; 32]) -> (result: bool) {
    return roundtrip(Provenance {
        source: source_value,
        producer: producer_value,
        transformation: transformation_value,
        generation: generation_value,
        evidence: evidence_value,
        ancestry: ancestry_value
    });
}
