mncs 0.13;

// store.envelope.v1 — semantic envelopes: inspect before materializing.
//
// An envelope exposes what an agent needs to decide WHETHER to fetch an
// object, without expanding any payload: identity, type, synopsis pointer,
// representation inventory, block topology, costs, provenance, and the
// fidelity levels available. Envelopes are small (256 bytes), content
// addressed, and independently retrievable.
//
// Fixed representation (256 bytes):
//
//   0..1     magic "EV"
//   2        representation version (1)
//   3        flags (bit0 has_synopsis, bit1 multi_rep, bit2 has_blocks)
//   4..15    logical object identity
//   16..47   type/schema identity (zero = untyped/legacy)
//   48..79   synopsis content identity (zero = absent)
//   80..87   synopsis stored bytes (0 = absent)
//   88..95   representation count
//   96..103  block count (1 with a zero table digest names the single
//            implicit whole-payload block; otherwise blocks in the stored
//            object block table)
//   104..111 default-representation stored bytes
//   112..119 default-representation plain bytes
//   120..151 default-representation root identity
//   152..183 provenance digest (zero = unrecorded)
//   184..215 object block-table digest (zero = single implicit block)
//   216..223 Store generation
//   224..231 fidelity bitmap (bit f set = fidelity f available, 0..5)
//   232..255 reserved (zero)
//
// Cost totals cover the DEFAULT representation only; per-representation
// bytes live in the representation table. This keeps the envelope fixed
// width while multi-representation accounting stays exact elsewhere.
module store.envelope.v1;

record Envelope {
    logical: [byte; 12],
    type_identity: [byte; 32],
    synopsis: [byte; 32],
    synopsis_bytes: u64,
    rep_count: u64,
    block_count: u64,
    stored_bytes: u64,
    plain_bytes: u64,
    default_root: [byte; 32],
    provenance: [byte; 32],
    block_table: [byte; 32],
    generation: u64,
    fidelity_bits: u64,
    flags: u64
}

fn u64_bytes(value: u64) -> (result: [byte; 8]) {
    let b0: byte = (value / 72057594037927936) as byte;
    let r0: u64 = value % 72057594037927936;
    let b1: byte = (r0 / 281474976710656) as byte;
    let r1: u64 = r0 % 281474976710656;
    let b2: byte = (r1 / 1099511627776) as byte;
    let r2: u64 = r1 % 1099511627776;
    let b3: byte = (r2 / 4294967296) as byte;
    let r3: u64 = r2 % 4294967296;
    let b4: byte = (r3 / 16777216) as byte;
    let r4: u64 = r3 % 16777216;
    let b5: byte = (r4 / 65536) as byte;
    let r5: u64 = r4 % 65536;
    let b6: byte = (r5 / 256) as byte;
    let b7: byte = (r5 % 256) as byte;
    return [b0, b1, b2, b3, b4, b5, b6, b7];
}

fn copy12(out: [byte; 256], offset: u64, value: [byte; 12]) -> (result: [byte; 256]) {
    iterate i over value carrying row: [byte; 256] = out {
        next row = replace(row, offset +% i, value[i]);
    }
    return row;
}

fn copy32(out: [byte; 256], offset: u64, value: [byte; 32]) -> (result: [byte; 256]) {
    iterate i over value carrying row: [byte; 256] = out {
        next row = replace(row, offset +% i, value[i]);
    }
    return row;
}

fn copy8(out: [byte; 256], offset: u64, value: [byte; 8]) -> (result: [byte; 256]) {
    iterate i over value carrying row: [byte; 256] = out {
        next row = replace(row, offset +% i, value[i]);
    }
    return row;
}

fn encode(value: Envelope) -> (result: [byte; 256]) {
    let seed: [byte; 256] = [0; 256];
    let tagged: [byte; 256] = replace(replace(replace(replace(seed,
        0, 69), 1, 86), 2, 1), 3, (value.flags % 256) as byte);
    let l: [byte; 256] = copy12(tagged, 4, value.logical);
    let t: [byte; 256] = copy32(l, 16, value.type_identity);
    let s: [byte; 256] = copy32(t, 48, value.synopsis);
    let sb: [byte; 256] = copy8(s, 80, u64_bytes(value.synopsis_bytes));
    let rc: [byte; 256] = copy8(sb, 88, u64_bytes(value.rep_count));
    let bc: [byte; 256] = copy8(rc, 96, u64_bytes(value.block_count));
    let st: [byte; 256] = copy8(bc, 104, u64_bytes(value.stored_bytes));
    let pl: [byte; 256] = copy8(st, 112, u64_bytes(value.plain_bytes));
    let dr: [byte; 256] = copy32(pl, 120, value.default_root);
    let pv: [byte; 256] = copy32(dr, 152, value.provenance);
    let bt: [byte; 256] = copy32(pv, 184, value.block_table);
    let g: [byte; 256] = copy8(bt, 216, u64_bytes(value.generation));
    return copy8(g, 224, u64_bytes(value.fidelity_bits));
}

// Structural codes: 0 valid, 1 wrong length, 2 magic, 3 version,
// 4 flags/reserved nonzero. `validate_exact` adds identity-domain checks.
fn validate(view: [byte; up_to 256]) -> (result: u64) {
    if view.len != 256 { return 1; }
    if view[0] != 69 || view[1] != 86 { return 2; }
    if view[2] != 1 { return 3; }
    if view[3] > 7 { return 4; }
    if !reserved_zero(view) { return 4; }
    return 0;
}

fn reserved_zero(view: [byte; up_to 256]) -> (result: bool) {
    let seed: [u64; 24] = [0; 24];
    iterate i over seed carrying zero: bool = true {
        next zero = zero && view[232 +% i] == 0;
    }
    return zero;
}

fn word(view: [byte; 256], offset: u64) -> (result: u64) {
    let b0: u64 = (view[offset] as u64) *% 72057594037927936;
    let b1: u64 = b0 +% ((view[offset +% 1] as u64) *% 281474976710656);
    let b2: u64 = b1 +% ((view[offset +% 2] as u64) *% 1099511627776);
    let b3: u64 = b2 +% ((view[offset +% 3] as u64) *% 4294967296);
    let b4: u64 = b3 +% ((view[offset +% 4] as u64) *% 16777216);
    let b5: u64 = b4 +% ((view[offset +% 5] as u64) *% 65536);
    let b6: u64 = b5 +% ((view[offset +% 6] as u64) *% 256);
    return b6 +% (view[offset +% 7] as u64);
}

fn bytes12(view: [byte; 256], offset: u64) -> (result: [byte; 12]) {
    let out: [byte; 12] = [0; 12];
    iterate i over out carrying row: [byte; 12] = out {
        next row = replace(row, i, view[offset +% i]);
    }
    return row;
}

fn bytes32(view: [byte; 256], offset: u64) -> (result: [byte; 32]) {
    let out: [byte; 32] = [0; 32];
    iterate i over out carrying row: [byte; 32] = out {
        next row = replace(row, i, view[offset +% i]);
    }
    return row;
}

fn flags(view: [byte; 256]) -> (result: u64) {
    return view[3] as u64;
}

fn logical(view: [byte; 256]) -> (result: [byte; 12]) {
    return bytes12(view, 4);
}

fn type_identity(view: [byte; 256]) -> (result: [byte; 32]) {
    return bytes32(view, 16);
}

fn synopsis(view: [byte; 256]) -> (result: [byte; 32]) {
    return bytes32(view, 48);
}

fn synopsis_bytes(view: [byte; 256]) -> (result: u64) {
    return word(view, 80);
}

fn rep_count(view: [byte; 256]) -> (result: u64) {
    return word(view, 88);
}

fn block_count(view: [byte; 256]) -> (result: u64) {
    return word(view, 96);
}

fn stored_bytes(view: [byte; 256]) -> (result: u64) {
    return word(view, 104);
}

fn plain_bytes(view: [byte; 256]) -> (result: u64) {
    return word(view, 112);
}

fn default_root(view: [byte; 256]) -> (result: [byte; 32]) {
    return bytes32(view, 120);
}

fn provenance(view: [byte; 256]) -> (result: [byte; 32]) {
    return bytes32(view, 152);
}

fn block_table(view: [byte; 256]) -> (result: [byte; 32]) {
    return bytes32(view, 184);
}

fn generation(view: [byte; 256]) -> (result: u64) {
    return word(view, 216);
}

fn fidelity_bits(view: [byte; 256]) -> (result: u64) {
    return word(view, 224);
}

fn zero12(value: [byte; 12]) -> (result: bool) {
    iterate i over value carrying zero: bool = true {
        next zero = zero && value[i] == 0;
    }
    return zero;
}

fn zero32(value: [byte; 32]) -> (result: bool) {
    iterate i over value carrying zero: bool = true {
        next zero = zero && value[i] == 0;
    }
    return zero;
}

fn equal12(left: [byte; 12], right: [byte; 12]) -> (result: bool) {
    iterate i over left carrying same: bool = true {
        next same = same && left[i] == right[i];
    }
    return same;
}

fn equal32(left: [byte; 32], right: [byte; 32]) -> (result: bool) {
    iterate i over left carrying same: bool = true {
        next same = same && left[i] == right[i];
    }
    return same;
}

// Full validation over the exact envelope width. Codes extend the
// structural validator: 5 zero logical identity, 6 zero representation
// count, 7 identity fidelity bit missing, 8 synopsis presence mismatch,
// 9 block-table presence mismatch, 10 multi_rep flag mismatch. Code 4
// covers the flags byte and the reserved tail, matching `validate`.
fn validate_exact(view: [byte; 256]) -> (result: u64) {
    if view[0] != 69 || view[1] != 86 { return 2; }
    if view[2] != 1 { return 3; }
    if view[3] > 7 { return 4; }
    if !reserved_zero(view) { return 4; }
    if zero12(logical(view)) { return 5; }
    if rep_count(view) == 0 { return 6; }
    if fidelity_bits(view) % 2 == 0 { return 7; }
    let synopsis_zero: bool = zero32(synopsis(view));
    let synopsis_empty: bool = synopsis_bytes(view) == 0;
    if synopsis_zero != synopsis_empty { return 8; }
    let table_zero: bool = zero32(block_table(view));
    let single_block: bool = block_count(view) <= 1;
    if table_zero == !single_block { return 9; }
    let multi: bool = rep_count(view) > 1;
    let flag_byte: u64 = view[3] as u64;
    let flag_multi: bool = (flag_byte % 4) / 2 == 1;
    if multi != flag_multi { return 10; }
    let flag_synopsis: bool = flag_byte % 2 == 1;
    if flag_synopsis == synopsis_zero { return 8; }
    let flag_blocks: bool = flag_byte / 4 == 1;
    if flag_blocks == table_zero { return 9; }
    return 0;
}

// Fidelity availability: bit f of the fidelity bitmap.
fn offers(view: [byte; 256], level: u64) -> (result: bool) {
    if level > 5 {
        return false;
    }
    let bits: u64 = fidelity_bits(view);
    let shifted: u64 = bits / pow2(level);
    return shifted % 2 == 1;
}

fn pow2(level: u64) -> (result: u64) {
    if level == 0 { return 1; }
    if level == 1 { return 2; }
    if level == 2 { return 4; }
    if level == 3 { return 8; }
    if level == 4 { return 16; }
    return 32;
}

// Fold helper for fidelity-bitmap assembly: set bit `level`, leaving other
// bits unchanged. Unknown levels leave the bitmap unchanged rather than
// trapping, so hosts can fold validated-but-open level sets.
fn bitmap_with(bits: u64, level: u64) -> (result: u64) {
    if level > 5 {
        return bits;
    }
    let bit: u64 = pow2(level);
    if (bits / bit) % 2 == 1 {
        return bits;
    }
    return bits +% bit;
}

// The default envelope synthesized for objects stored before envelopes
// existed: one exact identity representation covering `total` plain bytes
// whose stored chunk bytes equal the plain bytes. Deterministic and
// total, so legacy reads observe identical bytes to stored envelopes for
// the same shape.
fn envelope_default_for(
    logical_value: [byte; 12],
    content_value: [byte; 32],
    total: u64,
    generation_value: u64
) -> (result: [byte; 256]) {
    return encode(Envelope {
        logical: logical_value,
        type_identity: [0; 32],
        synopsis: [0; 32],
        synopsis_bytes: 0,
        rep_count: 1,
        block_count: 1,
        stored_bytes: total,
        plain_bytes: total,
        default_root: content_value,
        provenance: [0; 32],
        block_table: [0; 32],
        generation: generation_value,
        fidelity_bits: 33,
        flags: 0
    });
}

// Consistency of a stored envelope against the manifest facts it must
// describe. The manifest remains the authority for binding; this only
// verifies the envelope agrees with it.
fn envelope_consistent(
    view: [byte; 256],
    logical_value: [byte; 12],
    default_value: [byte; 32],
    total: u64,
    generation_value: u64
) -> (result: bool) {
    return validate_exact(view) == 0
        && equal12(logical(view), logical_value)
        && equal32(default_root(view), default_value)
        && plain_bytes(view) == total
        && generation(view) == generation_value;
}

fn roundtrip(value: Envelope) -> (result: bool) {
    let bytes: [byte; 256] = encode(value);
    return validate(bytes) == 0
        && equal12(logical(bytes), value.logical)
        && equal32(type_identity(bytes), value.type_identity)
        && equal32(synopsis(bytes), value.synopsis)
        && synopsis_bytes(bytes) == value.synopsis_bytes
        && rep_count(bytes) == value.rep_count
        && block_count(bytes) == value.block_count
        && stored_bytes(bytes) == value.stored_bytes
        && plain_bytes(bytes) == value.plain_bytes
        && equal32(default_root(bytes), value.default_root)
        && equal32(provenance(bytes), value.provenance)
        && equal32(block_table(bytes), value.block_table)
        && generation(bytes) == value.generation
        && fidelity_bits(bytes) == value.fidelity_bits
        && flags(bytes) == (value.flags % 256);
}

fn encode_fields(logical_value: [byte; 12], type_value: [byte; 32], synopsis_value: [byte; 32], synopsis_bytes_value: u64, rep_count_value: u64, block_count_value: u64, stored_value: u64, plain_value: u64, default_value: [byte; 32], provenance_value: [byte; 32], block_table_value: [byte; 32], generation_value: u64, fidelity_value: u64, flags_value: u64) -> (result: [byte; 256]) {
    return encode(Envelope {
        logical: logical_value,
        type_identity: type_value,
        synopsis: synopsis_value,
        synopsis_bytes: synopsis_bytes_value,
        rep_count: rep_count_value,
        block_count: block_count_value,
        stored_bytes: stored_value,
        plain_bytes: plain_value,
        default_root: default_value,
        provenance: provenance_value,
        block_table: block_table_value,
        generation: generation_value,
        fidelity_bits: fidelity_value,
        flags: flags_value
    });
}

fn roundtrip_fields(logical_value: [byte; 12], type_value: [byte; 32], synopsis_value: [byte; 32], synopsis_bytes_value: u64, rep_count_value: u64, block_count_value: u64, stored_value: u64, plain_value: u64, default_value: [byte; 32], provenance_value: [byte; 32], block_table_value: [byte; 32], generation_value: u64, fidelity_value: u64, flags_value: u64) -> (result: bool) {
    return roundtrip(Envelope {
        logical: logical_value,
        type_identity: type_value,
        synopsis: synopsis_value,
        synopsis_bytes: synopsis_bytes_value,
        rep_count: rep_count_value,
        block_count: block_count_value,
        stored_bytes: stored_value,
        plain_bytes: plain_value,
        default_root: default_value,
        provenance: provenance_value,
        block_table: block_table_value,
        generation: generation_value,
        fidelity_bits: fidelity_value,
        flags: flags_value
    });
}
