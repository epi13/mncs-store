mncs 0.13;

// store.relationship.v1 — first-class typed relationship records.
//
// Relationship bytes are not an application blob and are not JSON.  The
// fixed v1 representation is intentionally small enough for the existing
// Store chunk path and keeps the edge independently inspectable:
//
//   0..1   magic MR
//   2      representation version
//   3      flags (reserved, zero)
//   4      relation kind (1 derived_from, 2 affected_consumer,
//          3 about, 4 supersedes)
//   5..7   reserved
//   8..19  source logical object id
//   20..31 target logical object id
//   32..39 Store generation
//   40..71 provenance record identity/digest
//   72..79 relation ordinal within the commit
//
// Logical, content, representation, generation, and provenance identities
// remain separate.  A relation does not own the meaning of either endpoint;
// its producer supplies those identities and Commons (or another authority)
// supplies domain meaning.
module store.relationship.v1;

record Relation {
    kind: u64,
    source: [byte; 12],
    target: [byte; 12],
    generation: u64,
    provenance: [byte; 32],
    ordinal: u64
}

fn u64_bytes(value: u64) -> (result: [byte; 8]) {
    let b0: byte = (value / 72057594037927936) as byte;
    let r0: u64 = value % 72057594037927936;
    let b1: byte = (r0 / 281474976710656) as byte;
    let r1: u64 = r0 % 281474976710656;
    let b2: byte = (r1 / 1099511627776) as byte;
    let r2: u64 = r1 % 1099511627776;
    let b3: byte = (r2 / 4294967296) as byte;
    let r3: u64 = r2 % 4294967296;
    let b4: byte = (r3 / 16777216) as byte;
    let r4: u64 = r3 % 16777216;
    let b5: byte = (r4 / 65536) as byte;
    let r5: u64 = r4 % 65536;
    let b6: byte = (r5 / 256) as byte;
    let b7: byte = (r5 % 256) as byte;
    return [b0, b1, b2, b3, b4, b5, b6, b7];
}

fn copy12(out: [byte; 80], offset: u64, value: [byte; 12]) -> (result: [byte; 80]) {
    iterate i over value carrying row: [byte; 80] = out {
        next row = replace(row, offset +% i, value[i]);
    }
    return row;
}

fn copy32(out: [byte; 80], offset: u64, value: [byte; 32]) -> (result: [byte; 80]) {
    iterate i over value carrying row: [byte; 80] = out {
        next row = replace(row, offset +% i, value[i]);
    }
    return row;
}

fn copy8(out: [byte; 80], offset: u64, value: [byte; 8]) -> (result: [byte; 80]) {
    iterate i over value carrying row: [byte; 80] = out {
        next row = replace(row, offset +% i, value[i]);
    }
    return row;
}

fn encode(value: Relation) -> (result: [byte; 80]) {
    let seed: [byte; 80] = [0; 80];
    let tagged: [byte; 80] = replace(replace(replace(replace(replace(seed,
        0, 77), 1, 82), 2, 1), 3, 0), 4, value.kind as byte);
    let with_source: [byte; 80] = copy12(tagged, 8, value.source);
    let with_target: [byte; 80] = copy12(with_source, 20, value.target);
    let with_generation: [byte; 80] = copy8(with_target, 32, u64_bytes(value.generation));
    let with_provenance: [byte; 80] = copy32(with_generation, 40, value.provenance);
    return copy8(with_provenance, 72, u64_bytes(value.ordinal));
}

// Codes: 0 valid, 1 wrong length, 2 magic, 3 version, 4 reserved/flags,
// 5 unknown relation kind.
fn validate(view: [byte; up_to 80]) -> (result: u64) {
    if view.len != 80 {
        return 1;
    }
    if view[0] != 77 || view[1] != 82 {
        return 2;
    }
    if view[2] != 1 {
        return 3;
    }
    if view[3] != 0 || view[5] != 0 || view[6] != 0 || view[7] != 0 {
        return 4;
    }
    if view[4] < 1 || view[4] > 4 {
        return 5;
    }
    return 0;
}

fn kind(view: [byte; 80]) -> (result: u64) { return view[4] as u64; }

fn source(view: [byte; 80]) -> (result: [byte; 12]) {
    let out: [byte; 12] = [0; 12];
    iterate i over out carrying row: [byte; 12] = out {
        next row = replace(row, i, view[8 +% i]);
    }
    return row;
}

fn target(view: [byte; 80]) -> (result: [byte; 12]) {
    let out: [byte; 12] = [0; 12];
    iterate i over out carrying row: [byte; 12] = out {
        next row = replace(row, i, view[20 +% i]);
    }
    return row;
}

fn generation(view: [byte; 80]) -> (result: u64) {
    let b0: u64 = (view[32] as u64) *% 72057594037927936;
    let b1: u64 = b0 +% ((view[33] as u64) *% 281474976710656);
    let b2: u64 = b1 +% ((view[34] as u64) *% 1099511627776);
    let b3: u64 = b2 +% ((view[35] as u64) *% 4294967296);
    let b4: u64 = b3 +% ((view[36] as u64) *% 16777216);
    let b5: u64 = b4 +% ((view[37] as u64) *% 65536);
    let b6: u64 = b5 +% ((view[38] as u64) *% 256);
    return b6 +% (view[39] as u64);
}

fn provenance(view: [byte; 80]) -> (result: [byte; 32]) {
    let out: [byte; 32] = [0; 32];
    iterate i over out carrying row: [byte; 32] = out {
        next row = replace(row, i, view[40 +% i]);
    }
    return row;
}

fn ordinal(view: [byte; 80]) -> (result: u64) {
    let b0: u64 = (view[72] as u64) *% 72057594037927936;
    let b1: u64 = b0 +% ((view[73] as u64) *% 281474976710656);
    let b2: u64 = b1 +% ((view[74] as u64) *% 1099511627776);
    let b3: u64 = b2 +% ((view[75] as u64) *% 4294967296);
    let b4: u64 = b3 +% ((view[76] as u64) *% 16777216);
    let b5: u64 = b4 +% ((view[77] as u64) *% 65536);
    let b6: u64 = b5 +% ((view[78] as u64) *% 256);
    return b6 +% (view[79] as u64);
}

fn equal12(left: [byte; 12], right: [byte; 12]) -> (result: bool) {
    iterate i over left carrying same: bool = true {
        next same = same && left[i] == right[i];
    }
    return same;
}

fn equal32(left: [byte; 32], right: [byte; 32]) -> (result: bool) {
    iterate i over left carrying same: bool = true {
        next same = same && left[i] == right[i];
    }
    return same;
}

fn roundtrip(value: Relation) -> (result: bool) {
    let bytes: [byte; 80] = encode(value);
    return validate(bytes) == 0
        && kind(bytes) == value.kind
        && equal12(source(bytes), value.source)
        && equal12(target(bytes), value.target)
        && generation(bytes) == value.generation
        && equal32(provenance(bytes), value.provenance)
        && ordinal(bytes) == value.ordinal;
}

// Scalar/sequence transport entrypoint used by the checked-in corpus.  The
// boundary expands into the nominal Relation record immediately; callers do
// not persist an untyped JSON object.
fn encode_fields(kind_value: u64, source_value: [byte; 12], target_value: [byte; 12], generation_value: u64, provenance_value: [byte; 32], ordinal_value: u64) -> (result: [byte; 80]) {
    return encode(Relation {
        kind: kind_value,
        source: source_value,
        target: target_value,
        generation: generation_value,
        provenance: provenance_value,
        ordinal: ordinal_value
    });
}

fn roundtrip_fields(kind_value: u64, source_value: [byte; 12], target_value: [byte; 12], generation_value: u64, provenance_value: [byte; 32], ordinal_value: u64) -> (result: bool) {
    return roundtrip(Relation {
        kind: kind_value,
        source: source_value,
        target: target_value,
        generation: generation_value,
        provenance: provenance_value,
        ordinal: ordinal_value
    });
}
