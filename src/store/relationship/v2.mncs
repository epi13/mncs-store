mncs 0.13;

// store.relationship.v2 — generic first-class relationship records.
//
// relationship.v1 remains frozen: its closed numeric vocabulary is retained
// for existing Commons state and compatibility fixtures. v2 removes that
// application-specific vocabulary from the Store representation. The
// producer supplies a content identity for the relation type and may attach
// an immutable, typed metadata object by identity.
//
// Fixed representation (172 bytes):
//
//   0..1     magic MR
//   2        representation version (2)
//   3        flags (reserved, zero)
//   4..35    relation type identity (content/schema identity)
//   36..47   source logical object identity
//   48..59   target logical object identity
//   60..67   Store generation
//   68..99   provenance record identity/digest
//   100..107 ordinal within the commit
//   108..139 optional metadata type/schema identity (all zero = absent)
//   140..171 optional metadata object/root identity (all zero = absent)
//
// A v2 relation carries structure, not domain meaning. The producer and its
// owning authority define what relation_type means. Metadata is a separate
// typed immutable object; the relation stores its type and root identities
// without decoding its payload.
module store.relationship.v2;

record Relation {
    relation_type: [byte; 32],
    source: [byte; 12],
    target: [byte; 12],
    generation: u64,
    provenance: [byte; 32],
    ordinal: u64,
    metadata_type: [byte; 32],
    metadata_root: [byte; 32]
}

fn u64_bytes(value: u64) -> (result: [byte; 8]) {
    let b0: byte = (value / 72057594037927936) as byte;
    let r0: u64 = value % 72057594037927936;
    let b1: byte = (r0 / 281474976710656) as byte;
    let r1: u64 = r0 % 281474976710656;
    let b2: byte = (r1 / 1099511627776) as byte;
    let r2: u64 = r1 % 1099511627776;
    let b3: byte = (r2 / 4294967296) as byte;
    let r3: u64 = r2 % 4294967296;
    let b4: byte = (r3 / 16777216) as byte;
    let r4: u64 = r3 % 16777216;
    let b5: byte = (r4 / 65536) as byte;
    let r5: u64 = r4 % 65536;
    let b6: byte = (r5 / 256) as byte;
    let b7: byte = (r5 % 256) as byte;
    return [b0, b1, b2, b3, b4, b5, b6, b7];
}

fn copy12(out: [byte; 172], offset: u64, value: [byte; 12]) -> (result: [byte; 172]) {
    iterate i over value carrying row: [byte; 172] = out {
        next row = replace(row, offset +% i, value[i]);
    }
    return row;
}

fn copy32(out: [byte; 172], offset: u64, value: [byte; 32]) -> (result: [byte; 172]) {
    iterate i over value carrying row: [byte; 172] = out {
        next row = replace(row, offset +% i, value[i]);
    }
    return row;
}

fn copy8(out: [byte; 172], offset: u64, value: [byte; 8]) -> (result: [byte; 172]) {
    iterate i over value carrying row: [byte; 172] = out {
        next row = replace(row, offset +% i, value[i]);
    }
    return row;
}

fn equal12(left: [byte; 12], right: [byte; 12]) -> (result: bool) {
    iterate i over left carrying same: bool = true {
        next same = same && left[i] == right[i];
    }
    return same;
}

fn equal32(left: [byte; 32], right: [byte; 32]) -> (result: bool) {
    iterate i over left carrying same: bool = true {
        next same = same && left[i] == right[i];
    }
    return same;
}

fn zero32(value: [byte; 32]) -> (result: bool) {
    iterate i over value carrying zero: bool = true {
        next zero = zero && value[i] == 0;
    }
    return zero;
}

fn encode(value: Relation) -> (result: [byte; 172]) {
    let seed: [byte; 172] = [0; 172];
    let tagged: [byte; 172] = replace(replace(replace(replace(seed,
        0, 77), 1, 82), 2, 2), 3, 0);
    let typed: [byte; 172] = copy32(tagged, 4, value.relation_type);
    let s: [byte; 172] = copy12(typed, 36, value.source);
    let t: [byte; 172] = copy12(s, 48, value.target);
    let g: [byte; 172] = copy8(t, 60, u64_bytes(value.generation));
    let p: [byte; 172] = copy32(g, 68, value.provenance);
    let o: [byte; 172] = copy8(p, 100, u64_bytes(value.ordinal));
    let mt: [byte; 172] = copy32(o, 108, value.metadata_type);
    return copy32(mt, 140, value.metadata_root);
}

fn relation_type(view: [byte; 172]) -> (result: [byte; 32]) {
    let out: [byte; 32] = [0; 32];
    iterate i over out carrying row: [byte; 32] = out {
        next row = replace(row, i, view[4 +% i]);
    }
    return row;
}

fn source(view: [byte; 172]) -> (result: [byte; 12]) {
    let out: [byte; 12] = [0; 12];
    iterate i over out carrying row: [byte; 12] = out {
        next row = replace(row, i, view[36 +% i]);
    }
    return row;
}

fn target(view: [byte; 172]) -> (result: [byte; 12]) {
    let out: [byte; 12] = [0; 12];
    iterate i over out carrying row: [byte; 12] = out {
        next row = replace(row, i, view[48 +% i]);
    }
    return row;
}

fn generation(view: [byte; 172]) -> (result: u64) {
    let b0: u64 = (view[60] as u64) *% 72057594037927936;
    let b1: u64 = b0 +% ((view[61] as u64) *% 281474976710656);
    let b2: u64 = b1 +% ((view[62] as u64) *% 1099511627776);
    let b3: u64 = b2 +% ((view[63] as u64) *% 4294967296);
    let b4: u64 = b3 +% ((view[64] as u64) *% 16777216);
    let b5: u64 = b4 +% ((view[65] as u64) *% 65536);
    let b6: u64 = b5 +% ((view[66] as u64) *% 256);
    return b6 +% (view[67] as u64);
}

fn provenance(view: [byte; 172]) -> (result: [byte; 32]) {
    let out: [byte; 32] = [0; 32];
    iterate i over out carrying row: [byte; 32] = out {
        next row = replace(row, i, view[68 +% i]);
    }
    return row;
}

fn ordinal(view: [byte; 172]) -> (result: u64) {
    let b0: u64 = (view[100] as u64) *% 72057594037927936;
    let b1: u64 = b0 +% ((view[101] as u64) *% 281474976710656);
    let b2: u64 = b1 +% ((view[102] as u64) *% 1099511627776);
    let b3: u64 = b2 +% ((view[103] as u64) *% 4294967296);
    let b4: u64 = b3 +% ((view[104] as u64) *% 16777216);
    let b5: u64 = b4 +% ((view[105] as u64) *% 65536);
    let b6: u64 = b5 +% ((view[106] as u64) *% 256);
    return b6 +% (view[107] as u64);
}

fn metadata_type(view: [byte; 172]) -> (result: [byte; 32]) {
    let out: [byte; 32] = [0; 32];
    iterate i over out carrying row: [byte; 32] = out {
        next row = replace(row, i, view[108 +% i]);
    }
    return row;
}

fn metadata_root(view: [byte; 172]) -> (result: [byte; 32]) {
    let out: [byte; 32] = [0; 32];
    iterate i over out carrying row: [byte; 32] = out {
        next row = replace(row, i, view[140 +% i]);
    }
    return row;
}

// Structural codes: 0 valid, 1 wrong length, 2 magic, 3 version, 4 flags.
// The bounded-view validator deliberately stops at fields that are safe to
// inspect without an exact-width conversion. `validate_exact` adds the
// identity-domain checks once the caller has established the frozen width.
fn validate(view: [byte; up_to 172]) -> (result: u64) {
    if view.len != 172 { return 1; }
    if view[0] != 77 || view[1] != 82 { return 2; }
    if view[2] != 2 { return 3; }
    if view[3] != 0 { return 4; }
    return 0;
}

// Full v2 validation over the exact frozen representation. Codes extend the
// structural validator: 5 relation type identity is zero, 6 metadata
// type/root presence differs.
fn validate_exact(view: [byte; 172]) -> (result: u64) {
    if view[0] != 77 || view[1] != 82 { return 2; }
    if view[2] != 2 { return 3; }
    if view[3] != 0 { return 4; }
    let relation_type_zero: bool = zero32(relation_type(view));
    let metadata_type_zero: bool = zero32(metadata_type(view));
    let metadata_root_zero: bool = zero32(metadata_root(view));
    if relation_type_zero { return 5; }
    let metadata_mismatch: bool = (metadata_type_zero && !metadata_root_zero)
        || (!metadata_type_zero && metadata_root_zero);
    if metadata_mismatch { return 6; }
    return 0;
}

fn has_metadata(view: [byte; 172]) -> (result: bool) {
    return !zero32(metadata_type(view));
}

fn roundtrip(value: Relation) -> (result: bool) {
    let bytes: [byte; 172] = encode(value);
    return validate_exact(bytes) == 0
        && equal32(relation_type(bytes), value.relation_type)
        && equal12(source(bytes), value.source)
        && equal12(target(bytes), value.target)
        && generation(bytes) == value.generation
        && equal32(provenance(bytes), value.provenance)
        && ordinal(bytes) == value.ordinal
        && equal32(metadata_type(bytes), value.metadata_type)
        && equal32(metadata_root(bytes), value.metadata_root)
        && has_metadata(bytes) == (!zero32(value.metadata_type));
}

fn encode_fields(relation_type_value: [byte; 32], source_value: [byte; 12], target_value: [byte; 12], generation_value: u64, provenance_value: [byte; 32], ordinal_value: u64, metadata_type_value: [byte; 32], metadata_root_value: [byte; 32]) -> (result: [byte; 172]) {
    return encode(Relation {
        relation_type: relation_type_value,
        source: source_value,
        target: target_value,
        generation: generation_value,
        provenance: provenance_value,
        ordinal: ordinal_value,
        metadata_type: metadata_type_value,
        metadata_root: metadata_root_value
    });
}

fn roundtrip_fields(relation_type_value: [byte; 32], source_value: [byte; 12], target_value: [byte; 12], generation_value: u64, provenance_value: [byte; 32], ordinal_value: u64, metadata_type_value: [byte; 32], metadata_root_value: [byte; 32]) -> (result: bool) {
    return roundtrip(Relation {
        relation_type: relation_type_value,
        source: source_value,
        target: target_value,
        generation: generation_value,
        provenance: provenance_value,
        ordinal: ordinal_value,
        metadata_type: metadata_type_value,
        metadata_root: metadata_root_value
    });
}
